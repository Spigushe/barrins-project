# Copy this file to .env and fill in the required values.

# URL of the barrins_api backend
BARRINS_API_URL=http://localhost:8000

# Shared ingestion secret for POST /internal/scripture/ingest
# Generate with: openssl rand -hex 32
SCRIPTURE_INGEST_TOKEN=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# Optional: root of the JSON archive used by the sweep tool
# Defaults to apps/barrins_scripture/scraped/
BARRINS_SCRIPTURE_ARCHIVE_DIR=
