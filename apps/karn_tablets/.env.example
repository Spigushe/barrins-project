# Read-only Postgres credential scoped to bs_*/mj_cards only -- Karn
# Tablets never writes to barrins_api's schema (T6, ADR-13).
KARN_TABLETS_DATABASE_URL_RO=postgresql://karn_tablets_ro:changeme@localhost:5432/barrins

# barrins_api base URL.
BARRINS_API_URL=http://localhost:8000

# Shared secret authenticating Karn Tablets' push to
# POST /internal/karn/ingest (X-Karn-Token header) -- same shape as
# SCRIPTURE_INGEST_TOKEN.
KARN_INGEST_TOKEN=changeme

# Optional -- scripts/commander_report.py only (local analysis script, not
# used by the scheduled job). Database the report reads from; falls back to
# KARN_TABLETS_DATABASE_URL_RO when unset. Point it at a database that
# actually holds tournament data (staging keeps only 90 days, production
# keeps the full history). Needs SELECT on bs_* and mj_cards; SELECT on
# mj_sets is optional (recent-card suggestions).
# REPORT_DATABASE_URL=postgresql://<user>:changeme@<host>:5432/<db>
