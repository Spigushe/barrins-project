# Read-only Postgres credential scoped to bs_*/mj_cards only -- Karn
# Tablets never writes to barrins_api's schema (T6, ADR-13).
KARN_TABLETS_DATABASE_URL_RO=postgresql://karn_tablets_ro:changeme@localhost:5432/barrins

# barrins_api base URL.
BARRINS_API_URL=http://localhost:8000

# Shared secret authenticating Karn Tablets' push to
# POST /internal/karn/ingest (X-Karn-Token header) -- same shape as
# SCRIPTURE_INGEST_TOKEN.
KARN_INGEST_TOKEN=changeme
