# Python bytecode cache
__pycache__/
*.pyc
**/.venv/
**/*.egg*
**/.env

# Python test coverage reports
.coverage

# mkdocs build output
docs/site/

# graphify knowledge-graph cache/output — local, regenerated on demand
graphify-out/
docs/graphify-out/

# api logs
apps/barrins_api/logs/

# api on-disk cache (e.g. Scryfall image cache) — regenerated on demand
apps/barrins_api/var/cache/

# Barrin's Scripture's JSON archive — per T1/§1.3, this lives in its own git
# repository (a submodule pointing at mtg_decklist_cache or its durable
# successor), never inlined into this monorepo's own history. Until that
# submodule is wired up, local scrape runs just write into a plain local
# directory here — ignored so it's never accidentally committed.
apps/barrins_scripture/scraped/

# Ansible ops (ops/my-server) — Constitution ss34: secrets never live in git,
# even encrypted. Allow-list rather than block-list: everything under
# secrets/ is ignored except *.example templates and READMEs, so a new
# secret file is safe by default regardless of what it's named.
ops/my-server/venv/
ops/my-server/.vault-password-file.txt
ops/my-server/secrets/**
!ops/my-server/secrets/*/
!ops/my-server/secrets/**/*.example
!ops/my-server/secrets/**/README.md

# Generated from .claude/CLAUDE.md by docs/hooks/sync_constitution.py on every build.
docs/content/CLAUDE.md

# Generated from apps/<app>/README.md by docs/hooks/sync_readmes.py on every build.
# Add a new line here whenever an app gets a doc page under docs/content/**/<app>/.
docs/content/back/barrins_api/index.md
docs/content/back/barrins_identity/index.md
docs/content/front/tamiyo_scroll/index.md
docs/content/front/tolaria_news/index.md
docs/content/service/barrins_scripture/index.md
docs/content/service/karn_tablets/index.md
docs/content/shared/dc_calendar/index.md

# Generated from ops/my-server/roles/<role>/README.md by docs/hooks/sync_readmes.py
# on every build. Add a new line here whenever a role is added.
docs/content/ops/roles/backend_website/index.md
docs/content/ops/roles/create_ssh_key/index.md
docs/content/ops/roles/docs_site/index.md
docs/content/ops/roles/fastapi_backend/index.md
docs/content/ops/roles/github_token/index.md
docs/content/ops/roles/mtgjson_import_scheduler/index.md
docs/content/ops/roles/pgadmin/index.md
docs/content/ops/roles/postgres_backup/index.md
docs/content/ops/roles/react_frontend/index.md
docs/content/ops/roles/register_ssl/index.md
docs/content/ops/roles/scripture_ingest_token/index.md
docs/content/ops/roles/scripture_scraper/index.md
docs/content/ops/roles/setup_base_user/index.md
docs/content/ops/roles/setup_packages/index.md

# Generated from each sub-repo's own CHANGELOG.md by docs/hooks/sync_changelogs.py
# on every build. Add a new line here whenever a sub-repo is added.
docs/content/changelog/index.md
docs/content/changelog/barrins_api.md
docs/content/changelog/barrins_identity.md
docs/content/changelog/tamiyo_scroll.md
docs/content/changelog/tolaria_news.md
docs/content/changelog/docs.md
docs/content/changelog/ops.md

# collection_organization.py (personal script) -- both the Moxfield CSV
# export it reads and the CSV/JSON/Markdown binder maps it generates are
# personal collection data, never checked in.
apps/barrins_api/scripts/input/
apps/barrins_api/scripts/outputs/
node_modules
