# Managed by the backend_website role -- one limit_req_zone per entry in
# backend_website_rate_limited_paths. Must live in the nginx `http` context
# (conf.d, not sites-enabled/<vhost>), since limit_req_zone can't be
# declared inside a `server` block.
{% for p in backend_website_config.rate_limited_paths %}
limit_req_zone $binary_remote_addr zone={{ backend_website_config.zone_prefix }}_{{ p.zone }}:10m rate={{ p.rate }};
{% endfor %}
