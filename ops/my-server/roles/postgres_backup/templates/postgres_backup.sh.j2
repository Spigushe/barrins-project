#!/usr/bin/env bash
# Managed by Ansible (postgres_backup role) — do not edit on the server,
# changes will be overwritten on the next deploy.
#
# Dumps every non-template database (custom format, pg_restore-compatible)
# plus global roles/grants, into {{ postgres_backup_config.dir }}. Runs as
# the `postgres` OS user (systemd unit's User=), so it connects via local
# peer authentication — no password needed, nothing new to keep secret.
set -euo pipefail
umask 077

BACKUP_DIR="{{ postgres_backup_config.dir }}"
RETENTION_DAYS="{{ postgres_backup_config.retention_days }}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BACKUP_DIR"

databases="$(psql --tuples-only --no-align \
  --command "SELECT datname FROM pg_database WHERE NOT datistemplate;")"

for db in $databases; do
  pg_dump --format=custom "$db" > "${BACKUP_DIR}/${db}_${TIMESTAMP}.dump"
done

# Roles/grants aren't part of any single database dump — pg_dumpall is the
# only tool that exports them, hence the separate plain-SQL file here.
pg_dumpall --globals-only > "${BACKUP_DIR}/globals_${TIMESTAMP}.sql"

find "$BACKUP_DIR" -type f -mtime "+${RETENTION_DAYS}" -delete
