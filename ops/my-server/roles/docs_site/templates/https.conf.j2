server {
  listen  443 ssl;
  server_name {{ docs_site_config.server_name }};

  ssl_certificate         /etc/letsencrypt/live/{{ docs_site_config.server_name }}/fullchain.pem;
  ssl_certificate_key     /etc/letsencrypt/live/{{ docs_site_config.server_name }}/privkey.pem;
  ssl_trusted_certificate /etc/letsencrypt/live/{{ docs_site_config.server_name }}/fullchain.pem;

  include snippets/ssl-params.conf;

  access_log syslog:server=unix:/dev/log,nohostname;
  error_log syslog:server=unix:/dev/log,nohostname;

  root {{ docs_site_config.site_root }}/site;
  index index.html;
  charset utf-8;

  # Plain static multi-page site (mkdocs' "pretty URLs": every page is
  # <page>/index.html) — no SPA fallback needed, unlike react_frontend.
  location / { try_files $uri $uri/ =404; }
}
