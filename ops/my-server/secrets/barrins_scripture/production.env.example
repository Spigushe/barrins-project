# Template for secrets/barrins_scripture/production.env (vault-encrypted,
# see secrets/README.md for how to create it). Mirrors
# barrins-project/apps/barrins_scripture/.env.example — re-sync by hand if
# that file changes upstream.
#
# Deployed to ~/projects/barrins_scripture/apps/barrins_scripture/.env on
# every `ansible-playbook barrins_scripture.yml` run — read by the sweep
# wrapper script (barrins_scripture_sweep.sh.j2), not the scrape wrapper,
# which takes no credentials.

# =============================================================================
# BARRIN'S API — REQUIRED
# =============================================================================
BARRINS_API_URL=https://api.barrins-codex.org

# =============================================================================
# SCRIPTURE INGESTION TOKEN — REQUIRED
# =============================================================================
# Shared secret between barrins_api and Barrin's Scripture's sweep — sent as
# the X-Scripture-Token header on POST /internal/scripture/ingest.
#
# MUST be byte-for-byte identical to SCRIPTURE_INGEST_TOKEN in
# secrets/barrins_api/production.env — there is no centralized secret store
# for this value (unlike secrets/github/token.txt); keep both copies in sync
# by hand. Generate with: openssl rand -hex 32
SCRIPTURE_INGEST_TOKEN=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# =============================================================================
# JSON ARCHIVE — OPTIONAL
# =============================================================================
# Root of the JSON archive the sweep reads. Left empty here on purpose —
# the playbook always passes --archive-dir explicitly
# (scripture_scraper_config.output_dir) to the sweep wrapper script, so this
# only matters for a manual/local run outside the systemd timer.
BARRINS_SCRIPTURE_ARCHIVE_DIR=
