# Template for secrets/barrins_api/staging.env (vault-encrypted, see
# secrets/README.md for how to create it). Mirrors
# barrins-project/apps/barrins_api/.env.example — re-sync by hand if that
# file changes upstream.
#
# Deployed to ~/projects/api-staging.barrins-codex.org/.env on every
# `ansible-playbook barrins_api.yml -e deploy_env=staging` run.
#
# DATABASE_URL below MUST point at a dedicated staging database — never
# reuse the production one, or staging testing will corrupt real data.

# =============================================================================
# METADATA
# =============================================================================
PROJECT_NAME=Barrins Project/API (staging)
VERSION=1.0.0
API_STR=/api/v1

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=staging
DEBUG=false

# =============================================================================
# DATABASE — REQUIRED — dedicated staging database, not production's
# =============================================================================
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/REPLACE_STAGING_DB
DATABASE_ECHO=false

# =============================================================================
# SECURITY — IDENTITY TOKEN VERIFICATION (ADR-20) — REQUIRED
# =============================================================================
# barrins_api verifies barrins_identity access tokens against that
# service's JWKS (libs/identity_client) — it issues no JWTs of its own.
IDENTITY_SERVICE_URL=https://identity-staging.barrins-codex.org
IDENTITY_JWKS_CACHE_TTL_SECONDS=3600
# Service-account credentials for POST /service-token -> POST /users/lookup
# (team-roster / sharing display labels). Leave BOTH empty to disable the
# directory (labels fall back to a generic placeholder).
IDENTITY_SERVICE_CLIENT_ID=REPLACE_WITH_IDENTITY_SERVICE_ACCOUNT_CLIENT_ID
IDENTITY_SERVICE_CLIENT_SECRET=REPLACE_WITH_IDENTITY_SERVICE_ACCOUNT_SECRET
ALLOWED_ORIGINS=["https://tolaria-staging.barrins-codex.org","https://tamiyo-staging.barrins-codex.org"]

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# Signup / email verification / password reset are entirely
# apps/barrins_identity's since the identity cutover (ADR-20) —
# barrins_api sends no email, so there is no SMTP config here any more.

# =============================================================================
# MOXFIELD DECK IMPORT
# =============================================================================
# Not required on staging (ENVIRONMENT=staging falls back to a stub
# client returning a fixed sample deck if empty) — but fill in a real
# value here too, or the Moxfield-import UAT step can't actually be
# exercised against the real API before going to production.
MOXFIELD_USER_AGENT=REPLACE_WITH_MOXFIELD_ASSIGNED_USER_AGENT

# =============================================================================
# BARRIN'S SCRIPTURE INGESTION (T3)
# =============================================================================
# SCRIPTURE_INGEST_TOKEN is intentionally NOT set here. barrins_api.yml's
# scripture_ingest_token role reads
# secrets/scripture/staging_ingest_token.txt (one shared value per
# environment, not duplicated per app) and injects it into the deployed
# .env after this file is copied — see that role's README. Leave this key
# absent from this template; adding it here would just be a second,
# unused copy.

# =============================================================================
# KARN TABLETS INGESTION (T6)
# =============================================================================
# KARN_INGEST_TOKEN is intentionally NOT set here, for the same reason as
# SCRIPTURE_INGEST_TOKEN above. barrins_api.yml's karn_ingest_token role
# reads secrets/karn/staging_ingest_token.txt (one shared value per
# environment, read by both barrins_api.yml and karn_tablets.yml) and
# injects it into the deployed .env after this file is copied — see
# roles/karn_ingest_token/README.md.

# Descriptive User-Agent sent on Scryfall image-proxy requests, per
# Scryfall's API etiquette (no token/registration required, unlike
# Moxfield — not a secret, just an identifier). Recommended format:
# Barrin'sProject/<version>-<prod|staging|dev>. Empty in dev/test falls
# back to a stub client returning a placeholder image; production
# requires this to be set, or GET /cards/{id}/image returns 503.
SCRYFALL_USER_AGENT=
