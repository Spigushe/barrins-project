# Template for secrets/karn_tablets/production.env (vault-encrypted, see
# secrets/README.md for how to create it). Mirrors
# barrins-project/apps/karn_tablets/.env.example — re-sync by hand if that
# file changes upstream.
#
# Deployed to ~/projects/karn_tablets/apps/karn_tablets/.env on every
# `ansible-playbook karn_tablets.yml -e deploy_env=production` run —
# sourced by the run wrapper script (karn_tablets_run.sh.j2) before it
# invokes `karn-tablets`.

# =============================================================================
# READ-ONLY DATABASE CREDENTIAL — REQUIRED
# =============================================================================
# Karn Tablets only ever SELECTs from bs_*/mj_* (T6, ADR-13) — it never
# writes to barrins_api's schema. This must be a dedicated read-only role,
# NOT barrins_api's own DATABASE_URL. Create it once on the VPS (the
# playbook prints this reminder too):
#   sudo -u postgres psql -d barrins <<'SQL'
#   CREATE ROLE karn_tablets_ro LOGIN PASSWORD '<strong password>';
#   GRANT CONNECT ON DATABASE barrins TO karn_tablets_ro;
#   GRANT USAGE ON SCHEMA public TO karn_tablets_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO karn_tablets_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT TO karn_tablets_ro;
#   SQL
# Use a DIFFERENT password from the staging role (same isolation
# SECRET_KEY already requires). A plain synchronous URL — this is a batch
# job using psycopg2, not asyncpg.
KARN_TABLETS_DATABASE_URL_RO=postgresql://karn_tablets_ro:REPLACE_PASSWORD@localhost:5432/barrins

# =============================================================================
# BARRIN'S API — REQUIRED
# =============================================================================
BARRINS_API_URL=https://api.barrins-codex.org

# =============================================================================
# KARN TABLETS INGESTION TOKEN
# =============================================================================
# KARN_INGEST_TOKEN is intentionally NOT set here. karn_tablets.yml's
# karn_ingest_token role reads secrets/karn/production_ingest_token.txt
# (one shared value per environment, read by both barrins_api.yml and this
# playbook — see roles/karn_ingest_token/README.md) and injects it into
# the deployed .env after this file is copied. Leave this key absent from
# this template; adding it here would just be a second, unused copy.
