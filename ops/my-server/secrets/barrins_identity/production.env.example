# Template for secrets/barrins_identity/production.env (local-only,
# git-ignored — see secrets/README.md). Mirrors
# barrins-project/apps/barrins_identity/.env.example — re-sync by hand if
# that file changes upstream.
#
# barrins_identity is a standalone service: its own process, its own
# PostgreSQL database (NEVER barrins_api's), its own signing key.
# Deployed by a future ops/my-server/barrins_identity.yml — see
# docs/content/ops/deployment/identity.md.

# =============================================================================
# METADATA
# =============================================================================
PROJECT_NAME=Barrin's Identity
VERSION=0.1.0
API_STR=/api/v1

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE — REQUIRED
# =============================================================================
# A dedicated database/role, created by hand on the VPS. Never point this
# at barrins_api's database. Different password per environment. Prefer a
# hex password (openssl rand -hex 32) so the DSN needs no percent-encoding.
# On PG15+ the role must also own schema public — see
# docs/content/ops/deployment/identity.md "Preparation".
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/barrins_identity
DATABASE_ECHO=false

# =============================================================================
# JWT (RS256) — REQUIRED
# =============================================================================
# Generate with: openssl genrsa 2048
# Paste the PEM here (pydantic-settings accepts a multi-line value).
# Never commit a real key.
JWT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY_PEM
# Bump when rotating: publish the new public key under the new kid in
# JWKS before switching the private key.
JWT_KID=2026-08
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_TOKEN_EXPIRE_MINUTES=15

# =============================================================================
# ARGON2ID COST PARAMETERS
# =============================================================================
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# =============================================================================
# RATE LIMITING
# =============================================================================
LOGIN_RATE_LIMIT=5/minute

# =============================================================================
# CORS — REQUIRED
# =============================================================================
# Every frontend calling barrins_identity directly. No wildcard (§33).
ALLOWED_ORIGINS=["https://goblin.barrins-codex.org"]

# =============================================================================
# EMAIL VERIFICATION — REQUIRED IN PRODUCTION (ADR-3, ADR-16)
# =============================================================================
# Must be true in production. false is a dev/staging-only fallback and is
# rejected at startup here unless SMTP_HOST + FRONTEND_BASE_URL are unset
# together. Full setup (Brevo domain auth, OVH DNS records, OVH redirect,
# SMTP key, staging end-to-end) is in
# docs/content/ops/deployment/identity.md.
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=identity@barrins-codex.org
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Base for the links in verification / reset emails. Must not be the
# localhost default in production.
FRONTEND_BASE_URL=https://goblin.barrins-codex.org

# =============================================================================
# PASSWORD RESET
# =============================================================================
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT=5/minute

# =============================================================================
# PER-APP SETTINGS
# =============================================================================
MAX_APP_SETTINGS_BYTES=16384

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
