# Template for secrets/barrins_identity/staging.env (local-only,
# git-ignored — see secrets/README.md). Mirrors
# barrins-project/apps/barrins_identity/.env.example.
#
# Staging is where the Brevo / OVH email setup is proven before
# production — see docs/content/ops/deployment/identity.md, step 7.
# Different DATABASE_URL and signing key from production.

# =============================================================================
# METADATA
# =============================================================================
PROJECT_NAME=Barrin's Identity
VERSION=0.1.0
API_STR=/api/v1

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=staging
DEBUG=false

# =============================================================================
# DATABASE — REQUIRED (never production's)
# Prefer a hex password (openssl rand -hex 32) so the DSN needs no
# percent-encoding. On PG15+ the role must also own schema public — see
# docs/content/ops/deployment/identity.md "Preparation".
# =============================================================================
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/barrins_identity_staging
DATABASE_ECHO=false

# =============================================================================
# JWT (RS256) — REQUIRED (a different key from production)
# =============================================================================
JWT_PRIVATE_KEY=REPLACE_WITH_RSA_PRIVATE_KEY_PEM
JWT_KID=2026-08
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_TOKEN_EXPIRE_MINUTES=15

# =============================================================================
# ARGON2ID COST PARAMETERS
# =============================================================================
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# =============================================================================
# RATE LIMITING
# =============================================================================
LOGIN_RATE_LIMIT=5/minute

# =============================================================================
# CORS — REQUIRED
# =============================================================================
ALLOWED_ORIGINS=["https://goblin-staging.barrins-codex.org"]

# =============================================================================
# GOBLIN GUIDE REFRESH COOKIE (ADR-18)
# =============================================================================
# The Goblin Guide SPA opts in with `X-Client: web`; identity then keeps the
# refresh token in an HttpOnly cookie instead of the response body.
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_DOMAIN=identity-staging.barrins-codex.org
REFRESH_COOKIE_SAMESITE=none

# =============================================================================
# EMAIL VERIFICATION
# =============================================================================
# Prove the Brevo relay here first (step 7). Leaving SMTP_HOST empty makes
# the service log the code instead of sending — only acceptable on staging
# and only with ENVIRONMENT=staging (production refuses to boot that way).
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_KEY
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=identity@barrins-codex.org
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_BASE_URL=https://goblin-staging.barrins-codex.org

# =============================================================================
# PASSWORD RESET
# =============================================================================
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT=5/minute

# =============================================================================
# PER-APP SETTINGS
# =============================================================================
MAX_APP_SETTINGS_BYTES=16384

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
